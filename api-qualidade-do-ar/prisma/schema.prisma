generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model QualidadeAr {
  id            Int      @id @default(autoincrement())
  estacao        String
  timestamp     DateTime
  mp25          Float
  co            Float
  no3           Float
  temperatura   Float
  createdAt     DateTime @default(now())
}