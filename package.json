{
  "name": "aps-2026",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api-alagamento-inundacao",
    "api-qualidade-do-ar",
    "api-transito-e-transporte"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "build": "npm run db:generate && tsc",
    "dev:alagamento": "tsx api-alagamento-inundacao/index.ts",
    "dev:qualidade-ar": "tsx api-qualidade-do-ar/index.ts",
    "dev:transito": "tsx api-transito-e-transporte/index.ts",
    "test": "npm run build && node --test tests/api.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
