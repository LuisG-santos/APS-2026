POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aps
DB_PORT=5433
ALAGAMENTO_API_PORT=3001
QUALIDADE_AR_API_PORT=3002
TRANSITO_API_PORT=3003

# Conexao para executar as APIs e o Prisma na maquina local.
# Use os mesmos usuario, senha, banco e porta definidos acima.
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/aps

# Cache opcional ao executar as APIs na maquina local. Vazio desabilita o cache.
# Com port-forward do Service cache: REDIS_URL=redis://localhost:6379
REDIS_URL=

# Fila/worker: a API salva tarefas no banco mesmo se o worker estiver parado.
# Exemplo local: amqp://usuario:senha@localhost:5672?heartbeat=5
RABBITMQ_URL=
WORKER_PORT=3004
# Limites ilustrativos de demonstracao (nao sao parametros oficiais de seguranca).
ALERTA_NIVEL_CORREGO_CM=150
ALERTA_MP25=35
ALERTA_OCUPACAO=0.80
