generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoSensorAlagamento {
  NIVEL_CORREGO
  PLUVIOMETRO
  NIVEL_VIA
}

model SensorAlagamento {
  id        Int                  @id @default(autoincrement())
  nome      String               @unique
  tipo      TipoSensorAlagamento
  leituras  Alagamento[]
  createdAt DateTime             @default(now())
}

model Alagamento {
  id               Int              @id @default(autoincrement())
  sensorId         Int
  sensor           SensorAlagamento @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  timestamp        DateTime
  nivelCorregoCm   Float?
  chuvaAcumuladaMm Float?
  nivelAguaViaCm   Float?
  createdAt        DateTime         @default(now())

  @@index([sensorId, timestamp])
}

enum TipoSensorQualidadeAr {
  MP25
  CO
  NO2
  TEMPERATURA
}

model SensorQualidadeAr {
  id        Int                   @id @default(autoincrement())
  nome      String                @unique
  tipo      TipoSensorQualidadeAr
  estacao   String
  leituras  QualidadeAr[]
  createdAt DateTime              @default(now())
}

model QualidadeAr {
  id          Int               @id @default(autoincrement())
  sensorId    Int
  sensor      SensorQualidadeAr @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  timestamp   DateTime
  mp25        Float?
  co          Float?
  no2         Float?
  temperatura Float?
  createdAt   DateTime          @default(now())

  @@index([sensorId, timestamp])
}

enum TipoSensorTransito {
  RADAR
  GPS
  OCUPACAO
}

model SensorTransito {
  id        Int                @id @default(autoincrement())
  nome      String             @unique
  tipo      TipoSensorTransito
  leituras  Transito[]
  createdAt DateTime           @default(now())
}

model Transito {
  id         Int            @id @default(autoincrement())
  sensorId   Int
  sensor     SensorTransito @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  timestamp  DateTime
  posicao    String?
  velocidade Float?
  ocupacao   Float?
  createdAt  DateTime       @default(now())

  @@index([sensorId, timestamp])
}

enum DominioAlerta {
  ALAGAMENTO
  QUALIDADE_AR
  TRANSITO
}

// Trabalho gravado junto com a leitura e removido somente apos confirmacao da fila.
model TarefaAlerta {
  id        Int           @id @default(autoincrement())
  dominio   DominioAlerta
  leituraId Int
  sensorId  Int
  valor     Float
  timestamp DateTime
  createdAt DateTime      @default(now())

  @@unique([dominio, leituraId])
}

model Alerta {
  id        Int           @id @default(autoincrement())
  dominio   DominioAlerta
  leituraId Int
  sensorId  Int
  valor     Float
  limite    Float
  timestamp DateTime
  createdAt DateTime      @default(now())

  @@unique([dominio, leituraId])
  @@index([dominio, sensorId, timestamp])
}
