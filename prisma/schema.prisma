generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Alagamento {
  id               Int      @id @default(autoincrement())
  sensor           String
  timestamp        DateTime
  nivelCorregoCm   Float
  chuvaAcumuladaMm Float
  createdAt        DateTime @default(now())
}

model QualidadeAr {
  id          Int      @id @default(autoincrement())
  sensor      String
  estacao     String
  timestamp   DateTime
  mp25        Float
  co          Float
  no3         Float
  temperatura Float
  createdAt   DateTime @default(now())
}

enum TipoSensorTransito {
  RADAR
  GPS
  OCUPACAO
}

model SensorTransito {
  id        Int               @id @default(autoincrement())
  nome      String            @unique
  tipo      TipoSensorTransito
  leituras  Transito[]
  createdAt DateTime          @default(now())
}

model Transito {
  id         Int            @id @default(autoincrement())
  sensorId   Int
  sensor     SensorTransito @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  timestamp  DateTime
  posicao    String?
  velocidade Float?
  ocupacao   Float?
  createdAt  DateTime       @default(now())

  @@index([sensorId, timestamp])
}
